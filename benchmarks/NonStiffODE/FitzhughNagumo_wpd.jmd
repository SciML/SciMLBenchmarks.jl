## Comparison with Non-RK methods

Now let's test Tsit5 and Vern9 against parallel extrapolation methods and an
Adams-Bashforth-Moulton:

```julia
setups = [Dict(:alg=>Tsit5(), :tags=>FITZHUGH_NAGUMO_RK_TAGS)
          Dict(:alg=>Vern9(), :tags=>FITZHUGH_NAGUMO_RK_TAGS)
          Dict(:alg=>VCABM(), :tags=>FITZHUGH_NAGUMO_MULTISTEP_TAGS)
          Dict(:alg=>Vern9(), :prob_choice => 2, :tags=>FITZHUGH_NAGUMO_RK_TAGS)
          Dict(:alg=>VCABM(), :prob_choice => 2, :tags=>FITZHUGH_NAGUMO_MULTISTEP_TAGS)
          Dict(:alg=>AitkenNeville(min_order = 1, max_order = 9, init_order = 4, threading = true), :tags=>FITZHUGH_NAGUMO_EXTRAPOLATION_TAGS)
          Dict(:alg=>ExtrapolationMidpointDeuflhard(
              min_order = 1, max_order = 9, init_order = 4, threading = true), :tags=>FITZHUGH_NAGUMO_EXTRAPOLATION_TAGS)
          Dict(:alg=>ExtrapolationMidpointHairerWanner(
              min_order = 2, max_order = 11, init_order = 4, threading = true), :tags=>FITZHUGH_NAGUMO_EXTRAPOLATION_TAGS)]
solnames = ["Tsit5", "Vern9", "VCABM", "Vern9 Static", "VCABM Static",
    "AitkenNeville", "Midpoint Deuflhard", "Midpoint Hairer Wanner"]
wp = WorkPrecisionSet(
    probs, abstols, reltols, setups; appxsol = test_sol, names = solnames,
    error_estimates = [:final], save_everystep = false, verbose = SciMLLogging.None(), numruns = 100)
print_work_table(wp, FITZHUGH_NAGUMO_ERROR_FLOOR)
plot(wp)
```

```julia
setups = [Dict(:alg=>ExtrapolationMidpointDeuflhard(
              min_order = 1, max_order = 9, init_order = 9, threading = false), :tags=>FITZHUGH_NAGUMO_EXTRAPOLATION_TAGS)
          Dict(:alg=>ExtrapolationMidpointHairerWanner(
              min_order = 2, max_order = 11, init_order = 4, threading = false), :tags=>FITZHUGH_NAGUMO_EXTRAPOLATION_TAGS)
          Dict(:alg=>ExtrapolationMidpointHairerWanner(
              min_order = 2, max_order = 11, init_order = 4, threading = true), :tags=>FITZHUGH_NAGUMO_EXTRAPOLATION_TAGS)
          Dict(:alg=>ExtrapolationMidpointHairerWanner(
              min_order = 2, max_order = 11, init_order = 4,
              sequence = :romberg, threading = true), :tags=>FITZHUGH_NAGUMO_EXTRAPOLATION_TAGS)
          Dict(:alg=>ExtrapolationMidpointHairerWanner(
              min_order = 2, max_order = 11, init_order = 4,
              sequence = :bulirsch, threading = true), :tags=>FITZHUGH_NAGUMO_EXTRAPOLATION_TAGS)]
solnames = ["Deuflhard", "No threads", "standard", "Romberg", "Bulirsch"]
wp = WorkPrecisionSet(
    probs, abstols, reltols, setups; appxsol = test_sol, names = solnames,
    error_estimates = [:final], save_everystep = false, verbose = SciMLLogging.None(), numruns = 100)
print_work_table(wp, FITZHUGH_NAGUMO_ERROR_FLOOR)
plot(wp)
```

```julia
setups = [Dict(:alg=>ExtrapolationMidpointHairerWanner(
              min_order = 2, max_order = 11, init_order = 10, threading = true), :tags=>FITZHUGH_NAGUMO_EXTRAPOLATION_TAGS)
          Dict(:alg=>ExtrapolationMidpointHairerWanner(
              min_order = 2, max_order = 11, init_order = 4, threading = true), :tags=>FITZHUGH_NAGUMO_EXTRAPOLATION_TAGS)
          Dict(:alg=>ExtrapolationMidpointHairerWanner(
              min_order = 5, max_order = 11, init_order = 10, threading = true), :tags=>FITZHUGH_NAGUMO_EXTRAPOLATION_TAGS)
          Dict(:alg=>ExtrapolationMidpointHairerWanner(
              min_order = 2, max_order = 15, init_order = 10, threading = true), :tags=>FITZHUGH_NAGUMO_EXTRAPOLATION_TAGS)
          Dict(:alg=>ExtrapolationMidpointHairerWanner(
              min_order = 5, max_order = 7, init_order = 6, threading = true), :tags=>FITZHUGH_NAGUMO_EXTRAPOLATION_TAGS)]
solnames = ["1", "2", "3", "4", "5"]
wp = WorkPrecisionSet(
    probs, abstols, reltols, setups; appxsol = test_sol, names = solnames,
    error_estimates = [:final], save_everystep = false, verbose = SciMLLogging.None(), numruns = 100)
print_work_table(wp, FITZHUGH_NAGUMO_ERROR_FLOOR)
plot(wp)
```

```julia; echo=false; results="hidden"; error=false
let
    series = Dict(wp.name => wp for wp in low_order_wp[:])
    table = work_table_markdown(low_order_wp, FITZHUGH_NAGUMO_ERROR_FLOOR)
    rows = Dict(
        map(split(chomp(table), '\n')[3:end]) do row
            columns = strip.(split(row, '|'; keepempty = false))
            return columns[1] => columns
        end
    )
    simd_names = ("MER5v2", "MER6v2", "RK6v4")
    @assert Set(wp.name for wp in low_order_wp[:] if :simd_rk in wp.tags) == Set(simd_names)
    for name in simd_names
        wp = series[name]
        points = usable_points(wp)
        @assert !isempty(points) "$name has no usable points"
        rhs, accepted = rows[name][8:9]
        @assert rhs == "—" "$name RHS calls should be —, got $rhs"
        @assert :rhs_calls_unavailable in wp.tags "$name lacks :rhs_calls_unavailable"
        selected = wp.stats[points[argmin(wp.errors.final[points])]].naccept
        @assert accepted == string(selected) "$name accepted steps should be $selected, got $accepted"
    end
    @assert :rhs_calls_unavailable ∉ series["Tsit5"].tags
    @assert !isnothing(tryparse(Int, rows["Tsit5"][8])) "Tsit5 RHS calls should be numeric"
end
```

```julia; echo=false; results="hidden"; error=false
let
    for w in low_order_wp.wps, metric in propertynames(w.errors)
        metric === :final || @assert !any(isfinite, getproperty(w.errors, metric)) "low-order $(w.name) stores a finite $metric error"
    end
    @assert length(sol_endpoint.t) == 2
    @assert length(sol2_endpoint.t) == 2
    @assert !sol_endpoint.dense
    @assert !sol2_endpoint.dense
    dense_wp = WorkPrecisionSet(probs, abstols, reltols, low_order_setups; appxsol = test_sol_dense,
        error_estimates = [:final], save_everystep = false, numruns = 1, maxiters = 1000)
    for (w, d) in zip(low_order_wp.wps, dense_wp.wps)
        @assert isequal(w.errors.final, d.errors.final) "low-order $(w.name) endpoint errors differ"
        for (a, b) in zip(w.stats, d.stats), field in fieldnames(typeof(a))
            @assert isequal(getfield(a, field), getfield(b, field)) "low-order $(w.name) $field differs"
        end
    end
end
```

```julia; echo=false; results="hidden"; error=false
assert_work_table_markdown_fixture()
```

## Conclusion

In the latest run, the OrdinaryDiffEq.jl methods are several times faster than the ODEInterface Hairer codes (`dopri5` and `dop853`) at every tolerance. The interpolation comparisons include only OrdinaryDiffEq.jl methods, since ODE.jl is not part of this benchmark's environment; its setups are left commented out for reference.

```julia, echo = false
using SciMLBenchmarks
SciMLBenchmarks.bench_footer(WEAVE_ARGS[:folder], WEAVE_ARGS[:file])
```
