---
title: Three Body Work-Precision Diagrams
author: Chris Rackauckas
---

```julia
using OrdinaryDiffEq, ODEInterfaceDiffEq, LSODA, Sundials, DiffEqDevTools, StaticArrays,
      IRKGaussLegendre
using OrdinaryDiffEqAdamsBashforthMoulton, OrdinaryDiffEqExtrapolation, OrdinaryDiffEqFIRK, OrdinaryDiffEqHighOrderRK, OrdinaryDiffEqLowOrderRK, OrdinaryDiffEqVerner
using SciMLLogging
using Plots;
gr()
include(joinpath(@__DIR__, "..", "workprecision_table.jl"))

const THREE_BODY_ERROR_FLOOR = 1.0e-14
const THREE_BODY_RK_TAGS = [:ordinarydiffeq, :explicit_rk, :nonstiff]
const THREE_BODY_IMPLICIT_RK_TAGS = [:ordinarydiffeq, :implicit_rk, :nonstiff]
const THREE_BODY_IRKGL_TAGS = [:irkgl, :implicit_rk, :nonstiff]
const THREE_BODY_MULTISTEP_TAGS = [:ordinarydiffeq, :adams, :multistep, :nonstiff]
const THREE_BODY_EXTRAPOLATION_TAGS = [:ordinarydiffeq, :extrapolation, :nonstiff]
const THREE_BODY_ODEINTERFACE_RK_TAGS = [:odeinterface, :explicit_rk, :nonstiff]
const THREE_BODY_ODEINTERFACE_MULTISTEP_TAGS = [:odeinterface, :adams, :multistep, :nonstiff]
const THREE_BODY_ODEINTERFACE_EXTRAPOLATION_TAGS = [:odeinterface, :extrapolation, :nonstiff]
const THREE_BODY_SUNDIALS_RK_TAGS = [:sundials, :explicit_rk, :nonstiff]
const THREE_BODY_LSODA_TAGS = [:lsoda, :multistep, :nonstiff]

## Define the ThreeBody Problem
const threebody_μ = parse(Float64, "0.012277471")
const threebody_μ′ = 1 - threebody_μ

function f(du, u, p, t)
    @inbounds begin
        # 1 = y₁
        # 2 = y₂
        # 3 = y₁'
        # 4 = y₂'
        D₁ = ((u[1]+threebody_μ)^2 + u[2]^2)^(3/2)
        D₂ = ((u[1]-threebody_μ′)^2 + u[2]^2)^(3/2)
        du[1] = u[3]
        du[2] = u[4]
        du[3] = u[1] + 2u[4] - threebody_μ′*(u[1]+threebody_μ)/D₁ -
                threebody_μ*(u[1]-threebody_μ′)/D₂
        du[4] = u[2] - 2u[3] - threebody_μ′*u[2]/D₁ - threebody_μ*u[2]/D₂
    end
end

function f(u, p, t)
    @inbounds begin
        # 1 = y₁
        # 2 = y₂
        # 3 = y₁'
        # 4 = y₂'
        D₁ = ((u[1]+threebody_μ)^2 + u[2]^2)^(3/2)
        D₂ = ((u[1]-threebody_μ′)^2 + u[2]^2)^(3/2)
        du1 = u[3]
        du2 = u[4]
        du3 = u[1] + 2u[4] - threebody_μ′*(u[1]+threebody_μ)/D₁ -
              threebody_μ*(u[1]-threebody_μ′)/D₂
        du4 = u[2] - 2u[3] - threebody_μ′*u[2]/D₁ - threebody_μ*u[2]/D₂
    end
    SA[du1, du2, du3, du4]
end

t₀ = 0.0;
T = parse(Float64, "17.0652165601579625588917206249")
tspan = (t₀, 2T)

prob = ODEProblem{true, SciMLBase.FullSpecialize}(
    f, [0.994, 0.0, 0.0, parse(Float64, "-2.00158510637908252240537862224")], tspan)
probstatic = ODEProblem{false}(
    f, SA[0.994, 0.0, 0.0, parse(Float64, "-2.00158510637908252240537862224")], tspan)

sol_endpoint = solve(prob, Vern7(), abstol = 1/10^14, reltol = 1/10^14, save_everystep = false, dense = false)
sol2_endpoint = solve(probstatic, Vern7(), abstol = 1/10^14, reltol = 1/10^14, save_everystep = false, dense = false)
probs = [prob, probstatic]
test_sol = [sol_endpoint, sol2_endpoint];

abstols = 1.0 ./ 10.0 .^ (3:13);
reltols = 1.0 ./ 10.0 .^ (0:10);
```

Each sweep requests only the endpoint error with `error_estimates = [:final]` and
attaches solver metadata tags to the results. The table accompanying each existing
work-precision figure reports the best endpoint error, that point's timing,
right-hand-side calls, accepted steps, and the computed refinement rate over mean
accepted step sizes. The existing solvers are adaptive, so the fixed-step observed
order is unavailable. Rate calculations exclude errors at or below `1e-14`, the
tolerance used to construct each numerical endpoint reference; an em dash means the
grid did not resolve a rate or a counter is unavailable.

See that it's periodic in the chosen timespan:

```julia
sol = solve(prob, Vern9(), abstol = 1e-14, reltol = 1e-14, save_everystep = false, dense = false)
@show sol.u[1] - sol.u[end]
@show sol.u[end] - prob.u0;
```

This three-body problem is known to be a tough problem. Let's see how the algorithms do at standard tolerances.

### 5th Order Runge-Kutta Methods

```julia
setups = [Dict(:alg=>DP5(), :tags=>THREE_BODY_RK_TAGS)
          #Dict(:alg=>ode45()) #fails
          Dict(:alg=>BS5(), :tags=>THREE_BODY_RK_TAGS)
          Dict(:alg=>Tsit5(), :tags=>THREE_BODY_RK_TAGS)
          Dict(:alg=>IRKGL16(simd = true), :tags=>THREE_BODY_IRKGL_TAGS)
          Dict(:alg=>Tsit5(), :prob_choice => 2, :tags=>THREE_BODY_RK_TAGS)
          Dict(:alg=>dopri5(), :tags=>THREE_BODY_ODEINTERFACE_RK_TAGS)];
low_order_setups = setups
wp = WorkPrecisionSet(probs, abstols, reltols, setups; appxsol = test_sol, error_estimates = [:final],
    save_everystep = false, verbose = SciMLLogging.None(), numruns = 100)
low_order_wp = wp
print_work_table(wp, THREE_BODY_ERROR_FLOOR)
plot(wp)
```

#### Full save, but no dense

```julia
setups = [Dict(:alg=>DP5(), :dense=>false, :tags=>THREE_BODY_RK_TAGS)
          #Dict(:alg=>ode45()) # Fails
          Dict(:alg=>BS5(), :dense=>false, :tags=>THREE_BODY_RK_TAGS)
          Dict(:alg=>Tsit5(), :dense=>false, :tags=>THREE_BODY_RK_TAGS)
          Dict(:alg=>RadauIIA5(), :dense=>false, :tags=>THREE_BODY_IMPLICIT_RK_TAGS)
          Dict(:alg=>Tsit5(), :dense=>false, :prob_choice => 2, :tags=>THREE_BODY_RK_TAGS)
          Dict(:alg=>RadauIIA5(), :dense=>false, :prob_choice => 2, :tags=>THREE_BODY_IMPLICIT_RK_TAGS)
          Dict(:alg=>dopri5(), :tags=>THREE_BODY_ODEINTERFACE_RK_TAGS)];
wp = WorkPrecisionSet(probs, abstols, reltols, setups; appxsol = test_sol, error_estimates = [:final], numruns = 100)
print_work_table(wp, THREE_BODY_ERROR_FLOOR)
plot(wp)
```

#### Dense

```julia
setups = [Dict(:alg=>DP5(), :tags=>THREE_BODY_RK_TAGS)
          #Dict(:alg=>ode45()) #fails
          Dict(:alg=>BS5(), :tags=>THREE_BODY_RK_TAGS)
          Dict(:alg=>Tsit5(), :tags=>THREE_BODY_RK_TAGS)
          Dict(:alg=>IRKGL16(simd = true), :tags=>THREE_BODY_IRKGL_TAGS)
          Dict(:alg=>Tsit5(), :prob_choice => 2, :tags=>THREE_BODY_RK_TAGS)
          Dict(:alg=>dopri5(), :tags=>THREE_BODY_ODEINTERFACE_RK_TAGS)];
wp = WorkPrecisionSet(probs, abstols, reltols, setups; appxsol = test_sol, error_estimates = [:final], verbose = SciMLLogging.None(), numruns = 100)
print_work_table(wp, THREE_BODY_ERROR_FLOOR)
plot(wp)
```

In these tests the OrdinaryDiffEq.jl 5th order methods (`DP5`, `BS5` and `Tsit5`) are close to one another, and all of them are faster than `dopri5`. ODE.jl is not part of this benchmark's environment; its setups are left commented out for reference.

### Higher Order Algorithms

```julia
setups = [Dict(:alg=>DP5(), :tags=>THREE_BODY_RK_TAGS)
          Dict(:alg=>TanYam7(), :tags=>THREE_BODY_RK_TAGS)
          Dict(:alg=>DP8(), :tags=>THREE_BODY_RK_TAGS)
          Dict(:alg=>dop853(), :tags=>THREE_BODY_ODEINTERFACE_RK_TAGS)
          Dict(:alg=>Vern6(), :tags=>THREE_BODY_RK_TAGS)
          Dict(:alg=>Vern7(), :tags=>THREE_BODY_RK_TAGS)
          Dict(:alg=>Vern8(), :tags=>THREE_BODY_RK_TAGS)
          Dict(:alg=>Vern9(), :tags=>THREE_BODY_RK_TAGS)
          Dict(:alg=>IRKGL16(simd = false), :tags=>THREE_BODY_IRKGL_TAGS)
          Dict(:alg=>IRKGL16(simd = true), :tags=>THREE_BODY_IRKGL_TAGS)
          Dict(:alg=>Vern6(), :prob_choice => 2, :tags=>THREE_BODY_RK_TAGS)
          Dict(:alg=>Vern7(), :prob_choice => 2, :tags=>THREE_BODY_RK_TAGS)
          Dict(:alg=>Vern8(), :prob_choice => 2, :tags=>THREE_BODY_RK_TAGS)
          Dict(:alg=>Vern9(), :prob_choice => 2, :tags=>THREE_BODY_RK_TAGS)];
wp = WorkPrecisionSet(probs, abstols, reltols, setups; appxsol = test_sol, error_estimates = [:final],
    save_everystep = false, verbose = SciMLLogging.None(), numruns = 100)
print_work_table(wp, THREE_BODY_ERROR_FLOOR)
plot(wp)
```

```julia
wp = WorkPrecisionSet(probs, abstols, reltols, setups; appxsol = test_sol, error_estimates = [:final],
    dense = false, numruns = 100, verbose = SciMLLogging.None())
print_work_table(wp, THREE_BODY_ERROR_FLOOR)
plot(wp)
```

```julia
wp = WorkPrecisionSet(probs, abstols, reltols, setups; appxsol = test_sol, error_estimates = [:final], verbose = SciMLLogging.None(), numruns = 100)
print_work_table(wp, THREE_BODY_ERROR_FLOOR)
plot(wp)
```

In this test the Verner methods are the fastest at stringent tolerances, while `dop853` is the slowest of the adaptive methods.

### Other Algorithms

ODE.jl is not included, and Sundials' `CVODE_Adams` is left out since it fails at high tolerances.

```julia
#setups = [Dict(:alg=>ode78())
#          Dict(:alg=>VCABM())
#          Dict(:alg=>CVODE_Adams())];
#wp = WorkPrecisionSet(prob,abstols,reltols,setups;appxsol=test_sol,dense=false,numruns=100)
```

```julia
setups = [Dict(:alg=>DP5(), :tags=>THREE_BODY_RK_TAGS)
          Dict(:alg=>lsoda(), :tags=>THREE_BODY_LSODA_TAGS)
          Dict(:alg=>Vern8(), :tags=>THREE_BODY_RK_TAGS)
          Dict(:alg=>IRKGL16(simd = false), :tags=>THREE_BODY_IRKGL_TAGS)
          Dict(:alg=>IRKGL16(simd = true), :tags=>THREE_BODY_IRKGL_TAGS)
          Dict(:alg=>Vern8(), :prob_choice => 2, :tags=>THREE_BODY_RK_TAGS)
          Dict(:alg=>ddeabm(), :tags=>[THREE_BODY_ODEINTERFACE_MULTISTEP_TAGS..., :accepted_steps_unavailable])
          Dict(:alg=>odex(), :tags=>THREE_BODY_ODEINTERFACE_EXTRAPOLATION_TAGS)
          Dict(:alg=>ARKODE(Sundials.Explicit(), order = 6), :tags=>THREE_BODY_SUNDIALS_RK_TAGS)];
wp = WorkPrecisionSet(probs, abstols, reltols, setups; appxsol = test_sol, error_estimates = [:final],
    save_everystep = false, verbose = SciMLLogging.None(), numruns = 100)
print_work_table(wp, THREE_BODY_ERROR_FLOOR)
plot(wp)
```

Again, on cheap function calculations the Adams methods are shown to not be efficient once the error is sufficiently small. Also, as seen in other places, the extrapolation methods do not fare as well as the Runge-Kutta methods.

## Comparison with Non-RK methods

Now let's test Tsit5 and Vern9 against parallel extrapolation methods and an
Adams-Bashforth-Moulton:

```julia
abstols = 1.0 ./ 10.0 .^ (3:13);
reltols = 1.0 ./ 10.0 .^ (0:10);
setups = [Dict(:alg=>Tsit5(), :tags=>THREE_BODY_RK_TAGS)
          Dict(:alg=>Vern9(), :tags=>THREE_BODY_RK_TAGS)
          Dict(:alg=>IRKGL16(simd = false), :tags=>THREE_BODY_IRKGL_TAGS)
          Dict(:alg=>IRKGL16(simd = true), :tags=>THREE_BODY_IRKGL_TAGS)
          Dict(:alg=>Vern9(), :prob_choice => 2, :tags=>THREE_BODY_RK_TAGS)
          Dict(:alg=>AitkenNeville(min_order = 1, max_order = 9, init_order = 4, threading = true), :tags=>THREE_BODY_EXTRAPOLATION_TAGS)
          Dict(:alg=>ExtrapolationMidpointDeuflhard(
              min_order = 1, max_order = 9, init_order = 4, threading = true), :tags=>THREE_BODY_EXTRAPOLATION_TAGS)
          Dict(:alg=>ExtrapolationMidpointHairerWanner(
              min_order = 2, max_order = 11, init_order = 4, threading = true), :tags=>THREE_BODY_EXTRAPOLATION_TAGS)]
solnames = ["Tsit5", "Vern9", "IRKGL16", "IRKGL16 SIMD",
    "Vern9 Static",
    "AitkenNeville", "Midpoint Deuflhard", "Midpoint Hairer Wanner"]
wp = WorkPrecisionSet(
    probs, abstols, reltols, setups; appxsol = test_sol, names = solnames, error_estimates = [:final],
    save_everystep = false, verbose = SciMLLogging.None(), numruns = 100)
print_work_table(wp, THREE_BODY_ERROR_FLOOR)
plot(wp)
```

```julia
setups = [Dict(:alg=>ExtrapolationMidpointDeuflhard(
              min_order = 1, max_order = 9, init_order = 9, threading = false), :tags=>THREE_BODY_EXTRAPOLATION_TAGS)
          Dict(:alg=>ExtrapolationMidpointHairerWanner(
              min_order = 2, max_order = 11, init_order = 4, threading = false), :tags=>THREE_BODY_EXTRAPOLATION_TAGS)
          Dict(:alg=>ExtrapolationMidpointHairerWanner(
              min_order = 2, max_order = 11, init_order = 4, threading = true), :tags=>THREE_BODY_EXTRAPOLATION_TAGS)
          Dict(:alg=>ExtrapolationMidpointHairerWanner(
              min_order = 2, max_order = 11, init_order = 4,
              sequence = :romberg, threading = true), :tags=>THREE_BODY_EXTRAPOLATION_TAGS)
          Dict(:alg=>ExtrapolationMidpointHairerWanner(
              min_order = 2, max_order = 11, init_order = 4,
              sequence = :bulirsch, threading = true), :tags=>THREE_BODY_EXTRAPOLATION_TAGS)]
solnames = ["Deuflhard", "No threads", "standard", "Romberg", "Bulirsch"]
wp = WorkPrecisionSet(
    probs, abstols, reltols, setups; appxsol = test_sol, names = solnames, error_estimates = [:final],
    save_everystep = false, verbose = SciMLLogging.None(), numruns = 100)
print_work_table(wp, THREE_BODY_ERROR_FLOOR)
plot(wp)
```

```julia
setups = [Dict(:alg=>ExtrapolationMidpointHairerWanner(
              min_order = 2, max_order = 11, init_order = 10, threading = true), :tags=>THREE_BODY_EXTRAPOLATION_TAGS)
          Dict(:alg=>ExtrapolationMidpointHairerWanner(
              min_order = 2, max_order = 11, init_order = 4, threading = true), :tags=>THREE_BODY_EXTRAPOLATION_TAGS)
