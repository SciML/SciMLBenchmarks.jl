```


```julia; echo=false; results="hidden"; error=false
let
    series = Dict(wp.name => wp for wp in low_order_wp[:])
    table = work_table_markdown(low_order_wp, LOTKA_VOLTERRA_ERROR_FLOOR)
    rows = Dict(
        map(split(chomp(table), '\n')[3:end]) do row
            columns = strip.(split(row, '|'; keepempty = false))
            return columns[1] => columns
        end
    )
    simd_names = ("MER5v2", "MER6v2", "RK6v4")
    @assert Set(wp.name for wp in low_order_wp[:] if :simd_rk in wp.tags) == Set(simd_names)
    for name in simd_names
        wp = series[name]
        points = usable_points(wp)
        @assert !isempty(points) "$name has no usable points"
        rhs, accepted = rows[name][8:9]
        @assert rhs == "—" "$name RHS calls should be —, got $rhs"
        @assert :rhs_calls_unavailable in wp.tags "$name lacks :rhs_calls_unavailable"
        selected = wp.stats[points[argmin(wp.errors.final[points])]].naccept
        @assert accepted == string(selected) "$name accepted steps should be $selected, got $accepted"
    end
    @assert :rhs_calls_unavailable ∉ series["Tsit5"].tags
    @assert !isnothing(tryparse(Int, rows["Tsit5"][8])) "Tsit5 RHS calls should be numeric"
end
```

```julia; echo=false; results="hidden"; error=false
let
    for w in low_order_wp.wps, metric in propertynames(w.errors)
        metric === :final || @assert !any(isfinite, getproperty(w.errors, metric)) "low-order $(w.name) stores a finite $metric error"
    end
    @assert length(sol_endpoint.t) == 2
    @assert length(sol2_endpoint.t) == 2
    @assert !sol_endpoint.dense
    @assert !sol2_endpoint.dense
    dense_wp = WorkPrecisionSet(probs, low_order_abstols, low_order_reltols, low_order_setups;
        appxsol = test_sol_dense, error_estimates = [:final], save_everystep = false,
        verbose = SciMLLogging.None(), numruns = 1, maxiters = 10000)
    for (w, d) in zip(low_order_wp.wps, dense_wp.wps)
        @assert isequal(w.errors.final, d.errors.final) "low-order $(w.name) endpoint errors differ"
        for (a, b) in zip(w.stats, d.stats), field in fieldnames(typeof(a))
            @assert isequal(getfield(a, field), getfield(b, field)) "low-order $(w.name) $field differs"
        end
    end
end
```

```julia; echo=false; results="hidden"; error=false
assert_work_table_markdown_fixture()
```

## Conclusion

The OrdinaryDiffEq.jl explicit Runge-Kutta methods are quicker than `dopri5`, `dop853` and `IRKGL16` at every tolerance, and the gap in accuracy is largest when the interpolations are involved. ODE.jl is not part of this benchmark's environment; its setups are left commented out for reference.

```julia, echo = false, tangle = false
using SciMLBenchmarks
SciMLBenchmarks.bench_footer(WEAVE_ARGS[:folder], WEAVE_ARGS[:file])
```
