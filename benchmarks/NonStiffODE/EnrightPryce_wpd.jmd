```julia; echo=false; results="hidden"; error=false
assert_work_table_markdown_fixture()
```

```julia; echo=false; results="hidden"; error=false
let prob = NA_PROBLEMS[1]
    for w in na1_wp.wps, metric in propertynames(w.errors)
        metric === :final || @assert !any(isfinite, getproperty(w.errors, metric)) "NA1 $(w.name) stores a finite $metric error"
    end
    # An interpolating reference must give the same endpoint errors and solver counters.
    dense_ref = solve(prob, Vern9(), abstol=1/10^14, reltol=1/10^14)
    dense_wp = WorkPrecisionSet(prob, abstols, reltols, setups; appxsol=dense_ref, error_estimates=[:final], save_everystep=false, numruns=1)
    for (w, d) in zip(na1_wp.wps, dense_wp.wps)
        @assert isequal(w.errors.final, d.errors.final) "NA1 $(w.name) endpoint errors differ"
        for (a, b) in zip(w.stats, d.stats), field in fieldnames(typeof(a))
            @assert isequal(getfield(a, field), getfield(b, field)) "NA1 $(w.name) $field differs"
        end
    end
end
```

