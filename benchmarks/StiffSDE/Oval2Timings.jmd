  t1 = @elapsed sol = solve(prob,ImplicitEM(),EnsembleThreads(),dt=dts_imp[j],adaptive=false,maxiters=Int(1e11),save_everystep=false,verbose=SciMLLogging.None(),trajectories=trajectories)
