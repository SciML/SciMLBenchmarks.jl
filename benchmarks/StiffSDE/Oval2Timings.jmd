  best_adaptive_time = adaptive_time
  best_adaptive_run = "SRI(error_terms = 2) (abstol = 2^-13, reltol = 2^-7)"
end
println("The number of Adaptive Fails is $numfails. Elapsed time was $adaptive_time")
```

