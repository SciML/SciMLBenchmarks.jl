```julia
using Catalyst, JumpProcesses, JumpProblemLibrary, Plots, Statistics, DataFrames
```

# Model and example solutions

Here we implement a 1D continuous time random walk approximation of diffusion
for $N$ lattice sites on $\left[0,1\right]$, with reflecting boundary conditions
at $x=0$ and $x=1$. Note that our goal is to benchmark the non-spatial
well-mixed stochastic simulation algorithms (SSAs), so we do not benchmark the
spatial SSAs too here.

```julia
N = 256
h = 1 / N
tf = 0.01
methods = (Direct(), FRM(), SortingDirect(), NRM(), DirectCR(),
    RSSA(), RSSACR(), Coevolve(), RDirect())
shortlabels = [string(leg)[15:(end - 2)] for leg in methods]
jprob = JumpProblemLibrary.prob_jump_diffnetwork
rn = jprob.network(N)
u0 = jprob.u0(rn, N)
rates = [:K => 1 / (h * h)]
ploth = plot(reuse = false)
for (i, method) in enumerate(methods)
    println("Benchmarking method: ", method)
    jump_prob = JumpProblem(
        rn, u0, (0.0, tf), rates; aggregator = method, save_positions = (false, false)
    )
    sol = solve(jump_prob, SSAStepper(); saveat = tf/1000.0)
    plot!(ploth, sol.t, sol[Int(N//2), :], label = shortlabels[i])
end
plot!(ploth, title = "Population at middle lattice site", xlabel = "time")
```

# Benchmarking performance of the methods

```julia
function run_benchmark!(t, jump_prob, stepper)
    sol = solve(jump_prob, stepper)
    @inbounds for i in 1:length(t)
        t[i] = @elapsed (sol = solve(jump_prob, stepper))
    end
end
```

```julia
nsims = 50
benchmarks = Vector{Vector{Float64}}()
for method in methods
    jump_prob = JumpProblem(
        rn, u0, (0.0, tf), rates; aggregator = method, save_positions = (false, false)
    )
    stepper = SSAStepper()
    t = Vector{Float64}(undef, nsims)
    run_benchmark!(t, jump_prob, stepper)
    push!(benchmarks, t)
end
```

```julia
medtimes = Vector{Float64}(undef, length(methods))
stdtimes = Vector{Float64}(undef, length(methods))
avgtimes = Vector{Float64}(undef, length(methods))
for i in 1:length(methods)
    medtimes[i] = median(benchmarks[i])
    avgtimes[i] = mean(benchmarks[i])
    stdtimes[i] = std(benchmarks[i])
end

df = DataFrame(
    names = shortlabels, medtimes = medtimes, relmedtimes = (medtimes/medtimes[1]),
    avgtimes = avgtimes, std = stdtimes, cv = stdtimes ./ avgtimes)
```

# Plotting

```julia
sa = [string(round(mt, digits = 4), "s") for mt in df.medtimes]
bar(df.names, df.relmedtimes, legend = :false)
scatter!(df.names, 0.05 .+ df.relmedtimes, markeralpha = 0, series_annotations = sa)
ylabel!("median relative to Direct")
title!("256 Site 1D Diffusion CTRW")
```

# Weak error of adaptive tau-leaping

`SimpleAdaptiveTauLeaping` groups many reaction events into a single Poisson
leap, trading exactness for runtime. To measure what that trade buys on this
model we run a separate weak-error study on the same reflecting lattice, rates,
uniform initial occupancy and final time. The leaper needs a pure mass-action
jump problem built with the `PureLeaping()` aggregator, and `Direct()` with
`SSAStepper()` stays as the exact stochastic control.

The uniform initial condition is stationary, so the exact ensemble mean remains
10 particles at every site for any rate — a leaper that never moves particles
would still pass a mean-only check. We therefore grade on the ensemble variance
of the midpoint site occupancy at the final time, whose exact value is
`9.922077282` (a frozen trajectory returns zero variance instead). The mean
profile, total mass and nonnegativity are kept as sanity checks. Each
trajectory reseeds the problem RNG from a fixed seed set generated by
`StableRNG(1981)`, so the ensemble is reproducible and independent of the
thread count. Sampling uncertainty on the variance estimate is computed from
the fourth central moment of the midpoint samples, so a bias that is small
relative to it is reported as unresolved at this ensemble size.

```julia
using StableRNGs

exact_var_mid = 9.922077282
exact_mean_site = 10.0
total_mass = 10 * N
mid = Int(N // 2)
ensemble_size = 512
ensemble_seeds = rand(StableRNG(1981), 1:typemax(Int32), ensemble_size)
epsilons = (0.02, 0.05, 0.1, 0.2, 0.4)
```

```julia
# Run one seeded trajectory per entry of `seeds` and collect the final state and
# runtime of each. Every thread solves its own deepcopy of the problem so the
# per-solve seeded RNGs are never shared between trajectories.
function final_occupancy_ensemble(jprob, alg, seeds)
    jprobs = [deepcopy(jprob) for _ in 1:Threads.maxthreadid()]
    solve(jprobs[1], alg; seed = first(seeds), saveat = tf)  # warm up for timing
    finals = Vector{Vector{Int}}(undef, length(seeds))
    times = Vector{Float64}(undef, length(seeds))
    Threads.@threads for i in eachindex(seeds)
        times[i] = @elapsed sol = solve(
            jprobs[Threads.threadid()], alg; seed = seeds[i], saveat = tf)
        finals[i] = sol.u[end]
    end
    return finals, times
end

function midpoint_variance_summary(finals, times)
    mids = Float64[f[mid] for f in finals]
    v = var(mids)
    fourthmoment = mean((mids .- mean(mids)) .^ 4)
    # leading term of Var(sample variance) for M i.i.d. samples
    se = sqrt(max(fourthmoment - v^2, 0.0) / length(mids))
    bias = v - exact_var_mid
    meanprofile = sum(finals) ./ length(finals)
    return (;
        variance = v, se, bias,
        unresolved = abs(bias) <= 2 * se,
        mean_mid = mean(mids),
        max_mean_dev = maximum(abs.(meanprofile .- exact_mean_site)),
        min_occupancy = minimum(minimum.(finals)),
        mass_conserved = all(==(total_mass), sum.(finals)),
        medtime = median(times))
end
```

```julia
weakrows = NamedTuple[]
println("Weak-error ensemble control: Direct() + SSAStepper()")
direct_finals, direct_times = final_occupancy_ensemble(
    JumpProblem(rn, u0, (0.0, tf), rates; aggregator = Direct(),
        save_positions = (false, false)),
    SSAStepper(), ensemble_seeds)
push!(weakrows, (; method = "Direct (exact control)",
    midpoint_variance_summary(direct_finals, direct_times)...))
GC.gc()

leap_jprob = JumpProblem(rn, u0, (0.0, tf), rates; aggregator = PureLeaping())
for eps in epsilons
    println("Weak-error ensemble: SimpleAdaptiveTauLeaping epsilon = ", eps)
    leap_finals, leap_times = final_occupancy_ensemble(
        leap_jprob, SimpleAdaptiveTauLeaping(epsilon = eps), ensemble_seeds)
    push!(weakrows, (; method = "SimpleAdaptiveTauLeaping ε = $eps",
        midpoint_variance_summary(leap_finals, leap_times)...))
    GC.gc()
end

weakdf = DataFrame(
    method = [r.method for r in weakrows],
    var_mid = [r.variance for r in weakrows],
    se_var = [r.se for r in weakrows],
    bias = [r.bias for r in weakrows],
    unresolved = [r.unresolved for r in weakrows],
    mean_mid = [r.mean_mid for r in weakrows],
    max_mean_dev = [r.max_mean_dev for r in weakrows],
    min_occupancy = [r.min_occupancy for r in weakrows],
    mass_conserved = [r.mass_conserved for r in weakrows],
    medtime = [r.medtime for r in weakrows])
```

```julia
wpfig = plot(xlabel = "median runtime per trajectory (s)",
    ylabel = "|Var(X_mid(tf)) - $(exact_var_mid)|",
    title = "Adaptive tau-leaping weak error vs runtime",
    xscale = :log10, yscale = :log10, legend = :topright)
vline!(wpfig, [weakdf.medtime[1]]; label = "Direct (exact) median runtime",
    linestyle = :dash, color = :black)
hline!(wpfig, [2 * weakdf.se_var[1]]; label = "2 x control sampling s.e.",
    linestyle = :dot, color = :gray)
scatter!(wpfig, weakdf.medtime[2:end], abs.(weakdf.bias[2:end]);
    label = "SimpleAdaptiveTauLeaping", series_annotations = [string("ε = ", e) for e in epsilons])
```

