```

## Objective

`experiment_cost` integrates one experiment with RK4 and sums its weighted squared residuals
at the 15 samples after `t = 0` (at `t = 0` the observed states equal the data). `B5Cost`
holds the data, so GPU kernels receive them as an argument, and sums the experiments in an
unrolled loop.

```julia
# The observed states (raf1, erk, ap1, gsk3, p38, nfkb).
@assert b5_obs_idx == [22, 21, 26, 25, 24, 17]
observed(u) = SVector(u[22], u[21], u[26], u[25], u[24], u[17])

@noinline function experiment_cost(p, y0, c, obs)
    dt = 2.0 / NSUB
    u, s = y0 .* one(eltype(p)), zero(eltype(p))
    for k in 1:15
        for _ in 1:NSUB
            k1 = b5_rhs(u, p, c); k2 = b5_rhs(u + dt / 2 * k1, p, c)
            k3 = b5_rhs(u + dt / 2 * k2, p, c); k4 = b5_rhs(u + dt * k3, p, c)
            u = u + dt / 6 * (k1 + 2k2 + 2k3 + k4)
        end
        s += sum(abs2, (observed(u) - obs[k]) / 0.05)
    end
    return s
end

struct B5Cost{E}
    exps::E     # per experiment: (initial state, controls, the 15 observations after t = 0)
end
function (f::B5Cost)(p, _ = nothing)
    s = sum(ntuple(e -> experiment_cost(p, f.exps[e]...), Val(10)))
    return isfinite(s) ? s : 1.0e20 + zero(s)
end

const b5_cost = B5Cost(
    ntuple(
        e -> (
            SVector{26}(b5_y0[e]), Tuple(Float64.(b5_controls[e, :])),
            SVector{15}(ntuple(k -> SVector{6}(b5_data[e][k + 1, :]), 15)),
        ), 10
    )
)
const LB, UB = SVector{86}(p_lower), SVector{86}(p_upper)
```

Check: the RK4 cost against the same right-hand side under `Rodas5P` at tight tolerances, at
the nominal and starting parameters and at five random points in the bounds.

```julia
function rodas_cost(p)
    s = 0.0
    for (y0, c, obs) in b5_cost.exps
        prob = SciMLBase.ODEProblem{false}((u, q, t) -> b5_rhs(u, q, c), y0, (0.0, 30.0), SVector{86}(p))
        sol = solve(prob, OrdinaryDiffEqRosenbrock.Rodas5P(); reltol = 1.0e-10, abstol = 1.0e-12, saveat = 2.0)
        s += sum(k -> sum(abs2, (observed(sol.u[k + 1]) - obs[k]) / 0.05), 1:15)
    end
    return s
end

Random.seed!(1)
checkpoints = vcat(
    ["p_nom" => p_nom, "p_start" => p_start],
    ["random $i" => p_lower .+ rand(86) .* (p_upper .- p_lower) for i in 1:5]
)
for (name, p) in checkpoints
    a, b = b5_cost(SVector{86}(p)), rodas_cost(p)
    @printf "%-10s RK4 %12.2f   Rodas5P %12.2f   relative difference %.1e\n" name a b abs(a - b) / b
end
```

## Optimizers

The baselines are the global optimizers of the CPU B5 benchmark, `BBO_adaptive_de_rand_1_bin`
and `GN_CRS2_LM`, stopped by their own `maxtime`. The swarms use the same box and start from
uniform samples in it. The GPU swarms advance `CHUNK` iterations at a time, with the clock
read in between. Any error in a run is shown with the results, and the run then has no
result.

```julia
# A run's history: (seconds since its start, best cost so far) at every improvement.
const History = Vector{Tuple{Float64, Float64}}
record!(h, t0, v) = (isempty(h) || v < h[end][2]) && push!(h, (time() - t0, Float64(v)))

struct Stop <: Exception end

# Wrap the cost for a CPU optimizer: record every improvement and, with `stop`, end the run once
# the budget has passed.
function tracked(f, h, t0, budget; stop)
    return function (x, _ = nothing)
        stop && time() - t0 > budget && throw(Stop())
        v = f(SVector{86}(x))
        record!(h, t0, v)
        return v
    end
end

pso_problem(f) = OptimizationProblem{false}(
    OptimizationFunction{false}(f, SciMLBase.NoAD()), SVector{86}(p_start), nothing;
    lb = LB, ub = UB
)

function run_baseline(alg, h, t0, budget)
    g = tracked(b5_cost, h, t0, budget; stop = false)
    prob = OptimizationProblem(OptimizationFunction(g), copy(p_start); lb = p_lower, ub = p_upper)
    return solve(prob, alg; maxiters = 10^6, maxtime = budget)
end

function run_serial(h, t0, budget)
    g = tracked(b5_cost, h, t0, budget; stop = true)
    try
        solve(pso_problem(g), SerialPSO(SERIAL_PARTICLES); maxiters = 10^8)
    catch e
        e isa Stop || rethrow()
    end
    return nothing
end

function advance!(cache, h, t0)
    sol = SciMLBase.solve!(cache; maxiters = CHUNK)
    if cache.alg isa SyncPSOKernel                  # the sync kernel does not store its best back
        cache.gbest = ParallelParticleSwarms.SPSOGBest(sol.u, sol.objective)
    end
    return record!(h, t0, sol.objective)
end

# Always runs one chunk, so the warm-up compiles the update kernel.
function run_swarm(opt, h, t0, budget)
    cache = SciMLBase.init(pso_problem(b5_cost), opt)
    while true
        advance!(cache, h, t0)
        time() - t0 < budget || return nothing
    end
end

# label => runner(history, start time, budget)
const METHODS = [
    "PSOKernel" => (h, t0, b) -> run_swarm(PSOKernel(NUM_PARTICLES; backend = BACKEND, global_update = true), h, t0, b),
    "SyncPSOKernel" => (h, t0, b) -> run_swarm(SyncPSOKernel(NUM_PARTICLES; backend = BACKEND), h, t0, b),
    "SerialPSO" => (h, t0, b) -> run_serial(h, t0, b),
    "BBO_adaptive_de_rand_1_bin" => (h, t0, b) -> run_baseline(BBO_adaptive_de_rand_1_bin(), h, t0, b),
    "NLopt.GN_CRS2_LM()" => (h, t0, b) -> run_baseline(NLopt.GN_CRS2_LM(), h, t0, b),
]
const LABELS = first.(METHODS)
```

## Runs

```julia
const ERRORS = Dict{String, String}()   # optimizer => first line of its first error

function timed_run(label, runner, budget)
    h, t0 = History(), time()
    try
        runner(h, t0, budget)
    catch e
        get!(ERRORS, label, first(split(sprint(showerror, e), '\n')))
    end
    return h
end

best_at(h, t) = (i = findlast(x -> x[1] <= t, h); i === nothing ? Inf : h[i][2])
time_to(h, J) = (i = findfirst(x -> x[2] <= J, h); i === nothing ? Inf : h[i][1])

histories = Dict{String, Vector{History}}()
for (label, runner) in METHODS
    timed_run(label, runner, WARMUP)                          # compile; discarded
    histories[label] = [(Random.seed!(r); timed_run(label, runner, BUDGET)) for r in 1:NRUNS]
    @info label best = [best_at(h, BUDGET) for h in histories[label]]
end
```

## Results

Per optimizer: the best cost after `BUDGET` seconds in each run (median and best), how many
runs reached the eSS reference `J_REF`, and their median time to reach it. Any error follows
the table.

```julia
@printf "%-28s %14s %14s %10s %14s\n" "optimizer" "median best" "best" "≤ J_REF" "median time"
for l in sort(LABELS; by = l -> median(best_at.(histories[l], BUDGET)))
    b = best_at.(histories[l], BUDGET)
    t = filter(isfinite, time_to.(histories[l], J_REF))
    @printf "%-28s %14.1f %14.1f %7d/%-2d %14s\n" l median(b) minimum(b) length(t) NRUNS (isempty(t) ? "never" : @sprintf("%.1f s", median(t)))
end
for (l, msg) in sort(collect(ERRORS))
    println(l, ": ", msg)
end
```

## Best cost vs. wall-clock time

One line per optimizer: its median run. Lower is better; the dashed line is the eSS
reference.

```julia
const YTICKS = [3000, 4000, 5000, 7000, 10_000, 20_000]
function plot_histories()
    fig = Figure(size = (1100, 500))
    ax = Axis(
        fig[1, 1]; yscale = log10, xlabel = "Wall time (s)", ylabel = "Best cost so far",
        title = "BioPreDyn-bench B5", limits = ((0, BUDGET), nothing),
        yticks = (YTICKS, string.(YTICKS))
    )
    colors = Makie.wong_colors()[[1, 2, 3, 4, 6]]
    for (i, l) in enumerate(LABELS)
        hs = filter(!isempty, histories[l])
        isempty(hs) && continue
        h = hs[sortperm(best_at.(hs, BUDGET))[cld(end, 2)]]   # median run
        ts, vs = [first.(h); BUDGET], [last.(h); last(h)[2]]
        stairs!(ax, ts, vs; step = :post, color = colors[mod1(i, end)], label = l)
    end
    hlines!(ax, [J_REF]; color = :black, linestyle = :dash, label = "eSS reference (J = 3072.5)")
    Legend(fig[1, 2], ax; framevisible = false, merge = true)
    return fig
end
plot_histories()
```

